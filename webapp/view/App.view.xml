<mvc:View
    controllerName="com.clause.blockedorders.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m">

    <App id="app">
        <pages>
            <f:DynamicPage id="dynamicPage" headerExpanded="true" showFooter="false">

                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title text="{i18n>appTitle}" />
                        </f:heading>
                        <f:expandedContent>
                            <Label text="{i18n>appDescription}" />
                        </f:expandedContent>
                    </f:DynamicPageTitle>
                </f:title>

                <f:content>
                    <VBox>
                        <IconTabBar
                            id="issueFilterBar"
                            select=".onFilterSelect"
                            expandable="false"
                            applyContentPadding="false"
                            class="sapUiResponsiveContentPadding">
                            <items>
                                <IconTabFilter
                                    id="tabAll"
                                    key="all"
                                    text="{i18n>filterAll}"
                                    count="{orders>/counts/all}" />
                                <IconTabSeparator />
                                <IconTabFilter
                                    id="tabPayment"
                                    key="payment"
                                    icon="sap-icon://money-bills"
                                    iconColor="Negative"
                                    text="{i18n>filterPayment}"
                                    count="{orders>/counts/payment}" />
                                <IconTabFilter
                                    id="tabDelivery"
                                    key="delivery"
                                    icon="sap-icon://shipping-status"
                                    iconColor="Critical"
                                    text="{i18n>filterDelivery}"
                                    count="{orders>/counts/delivery}" />
                                <IconTabFilter
                                    id="tabOther"
                                    key="other"
                                    icon="sap-icon://question-mark"
                                    iconColor="Neutral"
                                    text="{i18n>filterOther}"
                                    count="{orders>/counts/other}" />
                            </items>
                        </IconTabBar>

                        <Table
                            id="ordersTable"
                            inset="false"
                            growing="true"
                            growingThreshold="20"
                            items="{
                                path: 'orders>/BlockedOrders',
                                sorter: { path: 'OrderDate', descending: true }
                            }"
                            noDataText="{i18n>tableNoData}">

                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>tableHeader}" level="H2" />
                                    <ToolbarSpacer />
                                    <SearchField
                                        id="customerSearch"
                                        width="16rem"
                                        placeholder="{i18n>searchPlaceholder}"
                                        liveChange=".onSearch" />
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column width="9rem">
                                    <Text text="{i18n>colOrder}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>colCustomer}" />
                                </Column>
                                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>colAmount}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>colOrderDate}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>colIssueType}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>colStatus}" />
                                </Column>
                                <Column hAlign="End" width="8rem">
                                    <Text text="" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem vAlign="Middle">
                                    <cells>
                                        <ObjectIdentifier title="{orders>OrderID}" />
                                        <Text text="{orders>CustomerName}" />
                                        <ObjectNumber
                                            number="{
                                                parts: [
                                                    { path: 'orders>OrderAmount' },
                                                    { path: 'orders>Currency' }
                                                ],
                                                type: 'sap.ui.model.type.Currency',
                                                formatOptions: { showMeasure: false }
                                            }"
                                            unit="{orders>Currency}" />
                                        <Text text="{
                                            path: 'orders>OrderDate',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: { source: { pattern: 'yyyy-MM-dd' }, style: 'medium' }
                                        }" />
                                        <ObjectStatus
                                            text="{
                                                path: 'orders>IssueType',
                                                formatter: '.formatter.issueTypeText'
                                            }"
                                            state="{
                                                path: 'orders>IssueType',
                                                formatter: '.formatter.issueTypeState'
                                            }" />
                                        <ObjectStatus
                                            text="{
                                                path: 'orders>Status',
                                                formatter: '.formatter.statusText'
                                            }"
                                            state="{
                                                path: 'orders>Status',
                                                formatter: '.formatter.statusState'
                                            }" />
                                        <Button
                                            text="{i18n>btnResolve}"
                                            type="Emphasized"
                                            enabled="{= ${orders>Status} !== 'resolved' }"
                                            press=".onResolvePress" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </f:content>

            </f:DynamicPage>
        </pages>
    </App>

</mvc:View>
